# GradeLens settings. Copy this file to .env and fill in what you need.
# Everything is optional: without an AI key the dashboard, at-risk list, CO attainment
# and reports all work. Only the "Ask AI" tab (and "Write with AI") needs a model.

# AI provider: openai | gemini | groq | openrouter | ollama | custom
LLM_PROVIDER=gemini
# The provider's API key (not needed for ollama)
LLM_API_KEY=
# Optional: override the provider's default model (it must support tool calling)
LLM_MODEL=
# Optional: only for "custom" (any OpenAI-compatible server) or a non-default URL.
# Ollama from inside Docker: http://host.docker.internal:11434/v1
LLM_BASE_URL=

# Optional: folder for the saved at-risk model (default: ./models)
GRADELENS_MODEL_DIR=
