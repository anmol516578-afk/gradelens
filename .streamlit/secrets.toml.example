# For Streamlit Community Cloud: paste these lines into App settings → Secrets.
# For local use: copy this file to .streamlit/secrets.toml (it is git-ignored).
# Environment variables, if set, take precedence over these values.

LLM_PROVIDER = "gemini"          # openai | gemini | groq | openrouter | ollama | custom
LLM_API_KEY = "paste-your-key-here"
# LLM_MODEL = "gemini-3.8-flash" # optional: override the provider's default model
# LLM_BASE_URL = ""              # optional: only for custom endpoints
